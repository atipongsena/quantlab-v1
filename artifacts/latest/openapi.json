                  "title": "Response Model Comparison Api V1 Models Comparison Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/market-data/verification": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Market Data Verification",
