          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Research Report Api V1 Research Report Get"
                }
              }
            }
          }
        }
      }
    },
